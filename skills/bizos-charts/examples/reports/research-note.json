 "summary": [
  {
   "zh": "收入增速 2025 年见底（7.4%），新品线放量后 2026E 回升至 18.1%（图表 1）。",
   "en": "Revenue growth troughed at 7.4% in 2025 and should recover to 18.1% in 2026E as new lines ramp (Exhibit 1)."
  },
  {
   "zh": "2025 年净利润增长 16%，销量贡献 9.8 百万元，足以覆盖物流与广告费用上升（图表 2）。",
   "en": "FY25 net profit rose 16%; volume added RMB9.8mn, more than offsetting higher logistics and ad costs (Exhibit 2)."
  },
  {
   "zh": "净利率 7.8% 列同业第 2，但 2026E P/E 15.6 倍低于同业中位数约四分之一（图表 3、5）。",
   "en": "A 7.8% net margin ranks second among peers, yet 2026E P/E of 15.6x is about a quarter below the peer median (Exhibits 3 and 5)."
  },
  {
   "zh": "DCF 基准情形对应 30.5 元；WACC 每升 1 个百分点，价值约降 4.2 元（图表 8）。",
   "en": "The DCF base case gives RMB30.5; each 1-point rise in WACC lowers value by about RMB4.2 (Exhibit 8)."
  }
 ],
